<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- The driver every log channel writes through. -->
    <type name="Kingletas\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>

    <!--
        Base handler: writes var/log/kingletas/default.log, rotated daily, 7
        files kept.
    -->
    <virtualType name="Kingletas\Logger\Handler\Base" type="Kingletas\Logger\Handler">
        <arguments>
            <argument name="fileName" xsi:type="string">default.log</argument>
        </arguments>
    </virtualType>

    <!-- Base logger channel. -->
    <virtualType name="Kingletas\Logger\Logger\Base" type="Kingletas\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">kingletas</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Kingletas\Logger\Handler\Base</item>
            </argument>
        </arguments>
    </virtualType>

</config>
